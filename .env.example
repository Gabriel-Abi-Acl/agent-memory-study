# Provedores: "fake" (offline, sem rede) ou "openai".
# openai só chama a API se o processo receber OPENAI_API_KEY.
# Este arquivo é modelo. Não commite um .env com chave.

LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake

# Janela deslizante: quantas mensagens recentes permanecem no contexto.
WINDOW_SIZE=8

# Resumo: mensagens recentes que ficam literais. O excedente vai para o sumarizador.
SUMMARY_RECENT_LIMIT=4

# Memória vetorial: quantos trechos a consulta devolve.
VECTOR_TOP_K=3

# Vazio mantém o cliente real desligado. Não cole uma chave neste arquivo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# Retry de 408/429/5xx. O teto corta um Retry-After longo demais.
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_DELAY_S=0.5
LLM_RETRY_MAX_DELAY_S=8
LLM_TIMEOUT_S=30

# Cache em disco das respostas de chat. Vazio desliga. A CLI também aceita --cache-dir.
# LLM_CACHE_DIR=.cache/llm

# USD por 1 milhão de tokens, só para estimar o modelo de chat no lugar da tabela
# de lista. Defina os dois, ou nenhum. Não é fatura.
# PROMPT_USD_PER_MILLION=
# COMPLETION_USD_PER_MILLION=
